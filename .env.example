# Postgres DSN used by the app and by Alembic.
DATABASE_URL=postgresql+psycopg://statements:statements@localhost:5432/statements

# Reject uploads larger than this (bytes). Default 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Host ports published by docker-compose. Change these if 5432/8000 are already
# in use on your machine.
DB_PORT=5432
API_PORT=8000
